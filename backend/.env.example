# Copia este fichero a `.env` y rellena SOLO lo que necesites.
# NUNCA escribas claves reales en este fichero de ejemplo ni lo subas
# a GitHub con valores. `.env` está en .gitignore.

# Token opcional de la API. Si está vacío, la API queda ABIERTA
# (solo para uso privado con la URL del túnel sin publicar).
# Si tiene valor, el frontend debe enviar
# `Authorization: Bearer <API_TOKEN>` en cada petición.
API_TOKEN=

# Orígenes permitidos para CORS, separados por comas.
# Pon aquí la URL de tu GitHub Pages, p. ej.:
# CORS_ORIGINS=https://carlosmiguelvaldesrodriguez-prog.github.io/elevenlabs-clon
# Si está vacío, solo se permite localhost (desarrollo).
# El notebook de Kaggle ya fija CORS_ORIGINS con esa URL por defecto.
CORS_ORIGINS=

# Directorio de datos (SQLite + audios + referencias). Por defecto ./data
DATA_DIR=

# 1 = modo solo CPU (InstaBox): Qwen3-TTS, Demucs y SFX devuelven 503.
CPU_ONLY=0

# Límites de subida en MB (por defecto: 100 general, 25 clonación, 500 doblaje)
MAX_UPLOAD_MB=
MAX_CLONE_MB=
MAX_DUBBING_MB=

# Rate limit: peticiones por minuto por IP (general / rutas pesadas)
RATE_LIMIT_PER_MINUTE=
HEAVY_RATE_LIMIT_PER_MINUTE=

# Texto máximo por petición TTS en caracteres (por defecto 10000)
MAX_TEXT_CHARS=

# Token de Hugging Face. Solo necesario para repos con términos
# (Stable Audio Open; pyannote para diarización). Nunca en el código.
HF_TOKEN=

# Servidor
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
